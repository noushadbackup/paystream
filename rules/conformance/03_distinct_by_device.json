{
  "description": "COUNT_DISTINCT counts accounts, not payments; grouping by device_id partitions by device.",
  "rules": [
    {"rule_id": "device-shared-by-accounts", "version": 1, "state": "ACTIVE", "group_by": "device_id",
     "when": [{"field": "sender_id", "op": "starts_with", "value": "U"}],
     "aggregate": {"fn": "COUNT_DISTINCT", "field": "sender_id"}, "window_s": 600,
     "threshold": {"op": ">=", "value": 3}, "cooldown_s": 600, "action": "REVIEW"}
  ],
