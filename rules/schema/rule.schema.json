{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noushadbackup/paystream/rules/schema/rule.schema.json",
  "title": "PayStream analyst rule",
  "description": "A streaming fraud rule. For each payment matching `when`, aggregate the payments with the same `group_by` value that also match `when` and happened in (t - window_s, t]; alert when the aggregate crosses the threshold. Evaluated by Flink (DynamicRuleEvaluator) and by the backtester (paystream_rules.engine) with identical results; see rules/conformance.",
  "type": "object",
  "required": ["rule_id", "version", "state", "group_by", "aggregate", "window_s", "threshold"],
  "additionalProperties": false,
  "properties": {
    "rule_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "version": {"type": "integer", "minimum": 1, "description": "Assigned by the rules service; immutable once published."},
    "name": {"type": "string", "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "state": {"enum": ["ACTIVE", "SHADOW", "DISABLED"], "description": "SHADOW rules alert with shadow=true and trigger no action: how a rule is trialled on live traffic."},
    "group_by": {"enum": ["sender_id", "receiver_id", "device_id", "district"]},
    "when": {"type": "array", "items": {"$ref": "#/$defs/condition"}, "maxItems": 10, "default": []},
    "aggregate": {
      "type": "object",
      "required": ["fn"],
      "additionalProperties": false,
      "properties": {
        "fn": {"enum": ["COUNT", "SUM", "MIN", "MAX", "AVG", "COUNT_DISTINCT"]},
        "field": {"$ref": "#/$defs/field"}
      }
    },
    "window_s": {"type": "integer", "minimum": 1, "maximum": 604800},
    "threshold": {
      "type": "object",
      "required": ["op", "value"],
      "additionalProperties": false,
      "properties": {"op": {"enum": [">=", ">"]}, "value": {"type": "number", "exclusiveMinimum": 0}}
    },
    "cooldown_s": {"type": "integer", "minimum": 0, "default": 600},
    "action": {"enum": ["REVIEW", "DECLINE"], "default": "REVIEW"},
    "tags": {"type": "array", "items": {"type": "string"}, "maxItems": 10}
  },
  "$defs": {
    "field": {"enum": ["txn_type", "sender_id", "receiver_id", "device_id", "district", "status", "channel",
                       "currency", "amount_paisa", "hour_dhaka"]},
    "condition": {
      "type": "object",
      "required": ["field", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "field": {"$ref": "#/$defs/field"},
        "op": {"enum": ["==", "!=", "in", "not_in", "<", "<=", ">", ">=", "starts_with"]},
        "value": {}
      }
    }
  }
}
