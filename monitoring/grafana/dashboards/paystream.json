{
  "uid": "paystream",
  "title": "PayStream: streaming health",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Events in per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(flink_taskmanager_job_task_operator_numRecordsOutPerSecond{operator_name=~\"Source: kafka-payments.*\"})",
          "legendFormat": "Events in per second"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer lag (records)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"paystream-flink\"})",
          "legendFormat": "Consumer lag (records)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Fraud alert detection latency p95 (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (rule) (flink_taskmanager_job_task_operator_rule_detectionLatencyMs{quantile=\"0.95\"})",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Alerts per minute by rule",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (rate(flink_taskmanager_job_task_operator_rule_alerts[1m])) * 60",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duplicates dropped per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_duplicatesDropped[1m]))",
          "legendFormat": "Duplicates dropped per second"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Invalid records (to DLQ) per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_invalidRecords[1m]))",
          "legendFormat": "Invalid records (to DLQ) per second"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Last checkpoint duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_lastCheckpointDuration)",
          "legendFormat": "Last checkpoint duration"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Last checkpoint size",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(flink_jobmanager_job_lastCheckpointSize)",
          "legendFormat": "Last checkpoint size"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Watermark lag (event time behind wall clock)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() * 1000) - min(flink_taskmanager_job_task_operator_currentOutputWatermark{operator_name=\"split-valid\"} > 0)",
          "legendFormat": "Watermark lag (event time behind wall clock)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Busy time of hottest operator",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (operator_name) (flink_taskmanager_job_task_busyTimeMsPerSecond) / 10",
          "legendFormat": "Busy time of hottest operator"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Decision API latency (server side)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(decision_latency_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(decision_latency_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Decisions per second by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(decisions_total[1m]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(decisions_degraded_total[1m]))",
          "legendFormat": "degraded (no features)"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Online store writes per second (Flink to Redis)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(flink_taskmanager_job_task_operator_redisWrites[1m]))",
          "legendFormat": "writes/s"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Shadow rules: alerts per minute they would have raised",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rule) (rate(flink_taskmanager_job_task_operator_rule_shadowAlerts[1m])) * 60",
          "legendFormat": "{{rule}}"
        }
      ]
    }
  ],
  "tags": [
    "paystream"
  ]
}
